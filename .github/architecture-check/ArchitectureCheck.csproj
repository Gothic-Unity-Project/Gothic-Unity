<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the layer and namespace rules of CoreArchitectureTest without Unity, so every PR (forks included) is
       checked without a Unity license. The MonoBehaviour rule needs Unity's reflection and stays EditMode only. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../Assets/Gothic-Tests/EditMode/Architecture/CoreLayerScanner.cs" Link="CoreLayerScanner.cs" />
  </ItemGroup>

</Project>
