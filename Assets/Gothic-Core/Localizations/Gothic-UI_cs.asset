  m_TableData:
  - m_Id: 193305458028961792
    m_Localized: "Vz\xEDt v\u0161e"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266604883968
    m_Localized: "Detaily p\u0159edm\u011Btu"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244096
    m_Localized: "Batoh v jedn\xE9 ruce, p\u0159edm\u011Bt ve druh\xE9 zobraz\xED
      jeho text"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244097
    m_Localized: "S\xE1n\xED batohu"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244098
    m_Localized: "Otev\u0159en\xFD batoh p\u0159itahuje p\u0159edm\u011Bty v okol\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244099
    m_Localized: "Ko\u0159ist: vz\xEDt v\u0161e"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244100
    m_Localized: "Batoh s ko\u0159ist\xED zobraz\xED \"Vz\xEDt v\u0161e\" pod str\xE1nkami"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244101
    m_Localized: "Blokov\xE1n\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244102
    m_Localized: "Ob\u011B ruce na zbrani na bl\xEDzko, oba spou\u0161t\u011B stisknuty:
      odr\xE1\u017Een\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244103
    m_Localized: Kroky
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244104
    m_Localized: "Kroky zn\xED podle podkladu"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244105
    m_Localized: "\u010C\xEDsla z\xE1sah\u016F"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244106
    m_Localized: "-X \u017DP / +X MANA nad hlavami NPC"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244107
    m_Localized: "Velikost \u010D\xEDsel z\xE1sah\u016F"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244108
    m_Localized: "Velikost \u010D\xEDsel -X \u017DP / +X MANA"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244109
    m_Localized: "\u010C\xEDsla \u017DP"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244110
    m_Localized: "\u017DP/MAX na ukazatel\xEDch zdrav\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244111
    m_Localized: "Ch\u016Fze v dialoz\xEDch"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244112
    m_Localized: "Pohyb b\u011Bhem rozhovoru - odchod dialog ukon\u010D\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244113
    m_Localized: "Obnoven\xED sv\u011Btla"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244114
    m_Localized: "Jak plynule sv\u011Btlo pochodn\u011B sleduje tvou ruku"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244115
    m_Localized: "N\xEDzk\xE9|St\u0159edn\xED|Vysok\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244116
    m_Localized: Ruce hrdiny
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244117
    m_Localized: "Tv\xE9 ruce jsou p\u011Bsti hrdiny"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244118
    m_Localized: "Dor\xE1\u017Een\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244119
    m_Localized: "Bodni a dr\u017E \u010Depel pro dor\xE1\u017Eku (vypnuto: jak\xFDkoli
      z\xE1sah)"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244120
    m_Localized: "Ku\u0161e"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244121
    m_Localized: "Nat\xE1hni t\u011Btivu pro nabit\xED (vypnuto: automaticky)"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244122
    m_Localized: "Jednor\xE1zov\xE9 svitky"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244123
    m_Localized: "Sesl\xE1n\xED svitek spot\u0159ebuje (Gothic)"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244124
    m_Localized: "Vr\u017Een\xE1 kouzla"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244125
    m_Localized: "\u0160vihni a pus\u0165 pro hozen\xED st\u0159eleck\xFDch kouzel"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244126
    m_Localized: "Nab\xEDjen\xED ob\u011Bma rukama"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244127
    m_Localized: "Nabit\xE1 kouzla rostou jen s ob\u011Bma rukama pohromad\u011B"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244128
    m_Localized: "Kruh obl\xEDben\xFDch"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244129
    m_Localized: "Ob\u011B ruce nahoru + oba spou\u0161t\u011B: vybaven\xE1 kouzla
      a zbran\u011B"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244130
    m_Localized: "M\u011B\u0161ec kaps\xE1\u0159e"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266638438400
    m_Localized: "G2: p\u0159i pl\xED\u017Een\xED m\u011B\u0161ec k uchopen\xED u
      ka\u017Ed\xE9ho, koho m\u016F\u017Ee\u0161 okr\xE1st"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266638438401
    m_Localized: "Velikost kruhu obl\xEDben\xFDch"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266638438402
    m_Localized: "Jak daleko je kruh obl\xEDben\xFDch od tebe (prav\xE1 p\xE1\u010Dka,
      kdy\u017E je otev\u0159en\xFD)"
    m_Metadata:
      m_Items: []
  - m_Id: 431630484627456
    m_Localized: _
    m_Metadata:
      m_Items: []
