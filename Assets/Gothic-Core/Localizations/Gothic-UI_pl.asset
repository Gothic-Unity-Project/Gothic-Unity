      m_Items: []
  - m_Id: 2692428107997184
    m_Localized: Mikrofon
    m_Metadata:
      m_Items: []
  - m_Id: 2692483179208704
    m_Localized: "U\u017Cywane do SpeechToText podczas dialog\xF3w (je\u015Bli zaznaczone)"
    m_Metadata:
      m_Items: []
  - m_Id: 2692692542087168
    m_Localized: Brak
    m_Metadata:
      m_Items: []
  - m_Id: 186269666525962240
    m_Localized: "Fizyczne d\u0142onie"
    m_Metadata:
      m_Items: []
  - m_Id: 186269666597265408
    m_Localized: "D\u0142onie zatrzymuj\u0105 si\u0119 na \u015Bcianach i obiektach
      i popychaj\u0105 lu\u017Ane przedmioty"
    m_Metadata:
      m_Items: []
  - m_Id: 186269666597265409
    m_Localized: "wy\u0142\u0105czone|w\u0142\u0105czone"
    m_Metadata:
      m_Items: []
  - m_Id: 188441999989669888
    m_Localized: Wiatr
    m_Metadata:
      m_Items: []
  - m_Id: 188442000027418624
    m_Localized: "Drzewa i trawa ko\u0142ysz\u0105 si\u0119 na wietrze - obci\u0105\u017Ca
      Questa"
    m_Metadata:
      m_Items: []
  - m_Id: 188130682066042880
    m_Localized: Winieta
    m_Metadata:
      m_Items: []
  - m_Id: 188130682107985920
    m_Localized: "Przyciemnia kraw\u0119dzie obrazu podczas ruchu lub obrotu dr\u0105\u017Ckiem"
    m_Metadata:
      m_Items: []
  - m_Id: 188130682107985921
    m_Localized: "wy\u0142\u0105czona|s\u0142aba|mocna"
    m_Metadata:
      m_Items: []
  - m_Id: 188130682107985922
    m_Localized: Rozmiar tekstu
    m_Metadata:
      m_Items: []
  - m_Id: 188130682107985923
    m_Localized: "Rozmiar napis\xF3w i opcji dialogowych"
    m_Metadata:
      m_Items: []
  - m_Id: 188130682107985924
    m_Localized: "normalny|du\u017Cy|wi\u0119kszy"
    m_Metadata:
      m_Items: []
  - m_Id: 188218529716502528
    m_Localized: "Widzenie kolor\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 188218529745862656
    m_Localized: Dostosowuje kolory do daltonizmu
    m_Metadata:
      m_Items: []
  - m_Id: 188218529745862657
    m_Localized: "normalne|s\u0142abe czerwone|s\u0142abe zielone|s\u0142abe niebieskie"
    m_Metadata:
      m_Items: []
  - m_Id: 188454143623823360
    m_Localized: "R\u0119czno\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 188454143661572096
    m_Localized: "Lewor\u0119czni: ruch i menu na prawym kontrolerze, obr\xF3t, teleport
      i skok na lewym"
    m_Metadata:
      m_Items: []
  - m_Id: 188454143661572097
    m_Localized: "prawor\u0119czni|lewor\u0119czni"
    m_Metadata:
      m_Items: []
  - m_Id: 188454143661572098
    m_Localized: Przycisk skoku
    m_Metadata:
      m_Items: []
  - m_Id: 188454143661572099
    m_Localized: "Przycisk skoku - kucanie na drugim z dw\xF3ch przycisk\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 188454143661572100
    m_Localized: "dolny przycisk|g\xF3rny przycisk|wci\u015Bni\u0119cie ga\u0142ki"
    m_Metadata:
      m_Items: []
  - m_Id: 188454143661572101
    m_Localized: Przycisk menu
    m_Metadata:
      m_Items: []
  - m_Id: 188454143661572102
    m_Localized: "Przycisk otwieraj\u0105cy menu, na r\u0119ce do ruchu"
    m_Metadata:
      m_Items: []
  - m_Id: 188454143661572103
    m_Localized: "g\xF3rny przycisk|dolny przycisk|przycisk menu"
    m_Metadata:
      m_Items: []
  - m_Id: 187174279474184192
    m_Localized: Wspinaczka
    m_Metadata:
      m_Items: []
  - m_Id: 187174279558070272
    m_Localized: "Chwycone kraw\u0119dzie: podci\u0105gnij si\u0119 albo przenie\u015B
      si\u0119 z wygaszeniem (mniej ruchu)"
    m_Metadata:
      m_Items: []
  - m_Id: 187174279558070273
    m_Localized: "podci\u0105ganie|wygaszenie"
    m_Metadata:
      m_Items: []
  - m_Id: 187174279558070274
    m_Localized: "Wskaz\xF3wki kraw\u0119dzi"
    m_Metadata:
      m_Items: []
  - m_Id: 187174279558070275
    m_Localized: "D\u0142o\u0144 zaciska si\u0119 i dr\u017Cy przy kraw\u0119dzi;
      \u015Bwiecenie pod\u015Bwietla kraw\u0119d\u017A"
    m_Metadata:
      m_Items: []
  - m_Id: 187174279558070276
    m_Localized: "wy\u0142\u0105czone|\u015Bwiecenie"
    m_Metadata:
      m_Items: []
  - m_Id: 187053241054658560
    m_Localized: "Korekta wysoko\u015Bci"
    m_Metadata:
      m_Items: []
  - m_Id: 187053241104990208
    m_Localized: "Wysoko\u015B\u0107 kamery co 5 cm. \u015Arodek = brak korekty"
    m_Metadata:
      m_Items: []
  - m_Id: 187128268206768128
    m_Localized: "Zapis niemo\u017Cliwy: gra nie jest uruchomiona."
    m_Metadata:
      m_Items: []
  - m_Id: 187128268236128256
    m_Localized: "Zapis niemo\u017Cliwy, gdy jeste\u015B martwy."
    m_Metadata:
      m_Items: []
  - m_Id: 187128268236128257
    m_Localized: "Zapis niemo\u017Cliwy podczas rozmowy."
    m_Metadata:
      m_Items: []
  - m_Id: 188222179017875456
    m_Localized: "Wczytanie nie powiod\u0142o si\u0119: nie mo\u017Cna odczyta\u0107
      zapisu."
    m_Metadata:
      m_Items: []
  - m_Id: 188222179131121664
    m_Localized: "Zapis nie powi\xF3d\u0142 si\u0119. Poprzedni zapis zosta\u0142
      zachowany."
    m_Metadata:
      m_Items: []
  - m_Id: 2692900000000000
    m_Localized: "pomi\u0144"
    m_Metadata:
      m_Items: []
  - m_Id: 191288694340444160
    m_Localized: Upadek bohatera
    m_Metadata:
      m_Items: []
  - m_Id: 191288694365609984
    m_Localized: "Nieprzytomny, martwy lub u\u015Bpiony: widok opada z cia\u0142em
      albo si\u0119 wygasza (mniej ruchu)"
    m_Metadata:
      m_Items: []
  - m_Id: 191288694365609985
    m_Localized: "z cia\u0142em|wygaszenie"
    m_Metadata:
      m_Items: []
  - m_Id: 193305458028961792
    m_Localized: "We\u017A wszystko"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266604883968
    m_Localized: "Szczeg\xF3\u0142y przedmiotu"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244096
    m_Localized: "Plecak w jednej r\u0119ce, przedmiot w drugiej pokazuje jego opis"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244097
    m_Localized: Zasysanie plecaka
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244098
    m_Localized: "Otwarty plecak wci\u0105ga pobliskie przedmioty"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244099
    m_Localized: "\u0141up: we\u017A wszystko"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244100
    m_Localized: "Plecak z \u0142upem pokazuje \"We\u017A wszystko\" pod stronami"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244101
    m_Localized: Blokowanie
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244102
    m_Localized: "Obie r\u0119ce na broni bia\u0142ej, obie spusty wci\u015Bni\u0119te:
      parowanie"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244103
    m_Localized: Kroki
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244104
    m_Localized: "Kroki brzmi\u0105 zale\u017Cnie od pod\u0142o\u017Ca"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244105
    m_Localized: "Liczby obra\u017Ce\u0144"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244106
    m_Localized: "-X HP / +X MANA nad g\u0142owami NPC"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244107
    m_Localized: "Rozmiar liczb obra\u017Ce\u0144"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244108
    m_Localized: Rozmiar liczb -X HP / +X MANA
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244109
    m_Localized: Liczby HP
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244110
    m_Localized: HP/MAX na paskach zdrowia
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244111
    m_Localized: Chodzenie w dialogach
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244112
    m_Localized: "Poruszaj si\u0119 podczas rozmowy - odej\u015Bcie ko\u0144czy dialog"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244113
    m_Localized: "Od\u015Bwie\u017Canie \u015Bwiat\u0142a"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244114
    m_Localized: "Jak p\u0142ynnie \u015Bwiat\u0142o pochodni pod\u0105\u017Ca za
      d\u0142oni\u0105"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244115
    m_Localized: "Niskie|\u015Arednie|Wysokie"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244116
    m_Localized: "D\u0142onie bohatera"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244117
    m_Localized: "Twoje d\u0142onie to pi\u0119\u015Bci bohatera"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244118
    m_Localized: Dobijanie
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244119
    m_Localized: "Wbij i przytrzymaj ostrze, by dobi\u0107 (wy\u0142.: ka\u017Cde
      trafienie)"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244120
    m_Localized: Kusza
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244121
    m_Localized: "Naci\u0105gnij ci\u0119ciw\u0119, by prze\u0142adowa\u0107 (wy\u0142.:
      automatycznie)"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244122
    m_Localized: Zwoje jednorazowe
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244123
    m_Localized: "Rzucenie zu\u017Cywa zw\xF3j (Gothic)"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244124
    m_Localized: "Rzucane zakl\u0119cia"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244125
    m_Localized: "Zamachnij si\u0119 i pu\u015B\u0107, by rzuci\u0107 zakl\u0119cie-pocisk"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244126
    m_Localized: "\u0141adowanie dwiema r\u0119kami"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244127
    m_Localized: "Na\u0142adowane zakl\u0119cia rosn\u0105 tylko przy obu d\u0142oniach
      razem"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244128
    m_Localized: "Pier\u015Bcie\u0144 ulubionych"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244129
    m_Localized: "Obie r\u0119ce w g\xF3r\u0119 + oba spusty: wyposa\u017Cone zakl\u0119cia
      i bronie"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244130
    m_Localized: Sakiewka kieszonkowca
    m_Metadata:
      m_Items: []
  - m_Id: 193331266638438400
    m_Localized: "G2: w skradaniu sakiewka do chwytu przy ka\u017Cdym, kogo mo\u017Cesz
      okra\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266638438401
    m_Localized: "Rozmiar pier\u015Bcienia ulubionych"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266638438402
    m_Localized: "Jak daleko od ciebie jest pier\u015Bcie\u0144 ulubionych (prawy
      dr\u0105\u017Cek, gdy jest otwarty)"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
