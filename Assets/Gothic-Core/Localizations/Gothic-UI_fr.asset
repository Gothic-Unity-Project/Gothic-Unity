    m_Metadata:
      m_Items: []
  - m_Id: 188454143623823360
    m_Localized: "Lat\xE9ralit\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 188454143661572096
    m_Localized: "Gaucher : d\xE9placement et menu sur la manette droite, rotation,
      t\xE9l\xE9port et saut sur la gauche"
    m_Metadata:
      m_Items: []
  - m_Id: 188454143661572097
    m_Localized: droitier|gaucher
    m_Metadata:
      m_Items: []
  - m_Id: 188454143661572098
