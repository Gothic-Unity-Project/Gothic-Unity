    m_Metadata:
      m_Items: []
  - m_Id: 188130682066042880
    m_Localized: Vignettage
    m_Metadata:
      m_Items: []
  - m_Id: 188130682107985920
    m_Localized: "Assombrit les bords de la vue quand le stick vous d\xE9place ou
      vous fait tourner"
    m_Metadata:
      m_Items: []
  - m_Id: 188130682107985921
    m_Localized: "d\xE9sactiv\xE9|l\xE9ger|fort"
    m_Metadata:
      m_Items: []
