  m_TableData:
  - m_Id: 193305458028961792
    m_Localized: Tout prendre
    m_Metadata:
      m_Items: []
  - m_Id: 193331266604883968
    m_Localized: "D\xE9tails de l'objet"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244096
    m_Localized: "Sac \xE0 dos dans une main, objet dans l'autre : affiche son texte"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244097
    m_Localized: Aspiration du sac
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244098
    m_Localized: Le sac ouvert attire les objets proches
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244099
    m_Localized: 'Butin : tout prendre'
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244100
    m_Localized: "Un sac de butin affiche \xAB Tout prendre \xBB sous les pages"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244101
    m_Localized: Parade
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244102
    m_Localized: "Deux mains sur une arme de m\xEAl\xE9e, deux g\xE2chettes enfonc\xE9es
      : parer"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244103
    m_Localized: Pas
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244104
    m_Localized: Les pas sonnent selon le sol
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244105
    m_Localized: "Chiffres de d\xE9g\xE2ts"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244106
    m_Localized: -X PV / +X MANA au-dessus des PNJ
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244107
    m_Localized: Taille des chiffres
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244108
    m_Localized: Taille des chiffres -X PV / +X MANA
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244109
    m_Localized: Chiffres de PV
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244110
    m_Localized: PV/MAX sur les barres de vie
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244111
    m_Localized: Marcher en dialogue
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244112
    m_Localized: "Se d\xE9placer en parlant - s'\xE9loigner met fin au dialogue"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244113
    m_Localized: "Rafra\xEEchissement lumi\xE8re"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244114
    m_Localized: "Fluidit\xE9 du suivi de la main par la lumi\xE8re d'une torche"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244115
    m_Localized: "Faible|Moyen|\xC9lev\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244116
    m_Localized: "Mains du h\xE9ros"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244117
    m_Localized: "Vos mains sont les poings du h\xE9ros"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244118
    m_Localized: "Coup de gr\xE2ce"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244119
    m_Localized: "Plantez et maintenez la lame pour achever (d\xE9sactiv\xE9 : tout
      coup)"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244120
    m_Localized: "Arbal\xE8te"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244121
    m_Localized: "Tendre la corde pour recharger (d\xE9sactiv\xE9 : automatique)"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244122
    m_Localized: "Parchemins \xE0 usage unique"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244123
    m_Localized: Un sort consomme le parchemin (Gothic)
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244124
    m_Localized: "Sorts lanc\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244125
    m_Localized: "Balancez et l\xE2chez pour lancer les sorts \xE0 projectile"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244128
    m_Localized: Anneau de favoris
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244129
    m_Localized: "Deux mains lev\xE9es + deux g\xE2chettes : sorts et armes \xE9quip\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244130
    m_Localized: Bourse de pickpocket
    m_Metadata:
      m_Items: []
  - m_Id: 193331266638438400
    m_Localized: "G2 : en se faufilant, une bourse \xE0 saisir sur qui vous pouvez
      voler"
    m_Metadata:
      m_Items: []
