  - m_Id: 193305458028961792
    m_Localized: Coger todo
    m_Metadata:
      m_Items: []
  - m_Id: 193331266604883968
    m_Localized: Detalles del objeto
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244096
    m_Localized: 'Mochila en una mano, objeto en la otra: muestra su texto'
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244097
    m_Localized: "Succi\xF3n de la mochila"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244098
    m_Localized: La mochila abierta atrae los objetos cercanos
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244099
    m_Localized: "Bot\xEDn: coger todo"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244100
    m_Localized: "Una mochila de bot\xEDn muestra \"Coger todo\" bajo las p\xE1ginas"
