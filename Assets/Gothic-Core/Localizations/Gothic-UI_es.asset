    m_Localized: "El bot\xF3n que salta: agacharse usa el otro de los dos botones"
    m_Metadata:
      m_Items: []
  - m_Id: 188454143661572100
    m_Localized: "bot\xF3n inferior|bot\xF3n superior|clic del stick"
