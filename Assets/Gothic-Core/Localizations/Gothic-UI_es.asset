    m_Localized: "Bot\xF3n de men\xFA"
    m_Metadata:
      m_Items: []
  - m_Id: 188454143661572102
    m_Localized: "El bot\xF3n que abre el men\xFA, en la mano de movimiento"
    m_Metadata:
      m_Items: []
  - m_Id: 188454143661572103
    m_Localized: "bot\xF3n superior|bot\xF3n inferior|bot\xF3n de men\xFA"
    m_Metadata:
      m_Items: []
