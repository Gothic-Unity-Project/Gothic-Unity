    m_Metadata:
      m_Items: []
  - m_Id: 187174279558070276
    m_Localized: desactivado|brillo
    m_Metadata:
      m_Items: []
  - m_Id: 187053241054658560
    m_Localized: Desfase de altura
    m_Metadata:
      m_Items: []
  - m_Id: 187053241104990208
    m_Localized: "Altura de c\xE1mara en pasos de 5 cm. Centro = sin desfase"
    m_Metadata:
      m_Items: []
  - m_Id: 187128268206768128
    m_Localized: 'No se puede guardar: no hay partida en curso.'
    m_Metadata:
      m_Items: []
  - m_Id: 187128268236128256
    m_Localized: "No se puede guardar mientras est\xE1s muerto."
    m_Metadata:
      m_Items: []
  - m_Id: 187128268236128257
    m_Localized: "No se puede guardar durante un di\xE1logo."
    m_Metadata:
      m_Items: []
