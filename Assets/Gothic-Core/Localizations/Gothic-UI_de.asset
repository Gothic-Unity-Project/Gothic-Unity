  - m_Id: 2692428107997184
    m_Localized: Mikrofon
    m_Metadata:
      m_Items: []
  - m_Id: 2692483179208704
    m_Localized: "Wird f\xFCr Sprache-zu-Text w\xE4hrend Dialogen verwendet, falls
      aktiviert"
    m_Metadata:
      m_Items: []
  - m_Id: 2692692542087168
    m_Localized: Deaktiviert
    m_Metadata:
      m_Items: []
  - m_Id: 186269666525962240
    m_Localized: "Physische H\xE4nde"
    m_Metadata:
      m_Items: []
  - m_Id: 186269666597265408
    m_Localized: "H\xE4nde stoppen an W\xE4nden und Objekten und schieben lose Gegenst\xE4nde"
    m_Metadata:
      m_Items: []
  - m_Id: 186269666597265409
    m_Localized: aus|an
    m_Metadata:
      m_Items: []
  - m_Id: 188441999989669888
    m_Localized: Wind
    m_Metadata:
      m_Items: []
  - m_Id: 188442000027418624
    m_Localized: "B\xE4ume und Gras wiegen sich im Wind - kostet Leistung auf der
      Quest"
    m_Metadata:
      m_Items: []
  - m_Id: 188130682066042880
    m_Localized: Vignette
    m_Metadata:
      m_Items: []
  - m_Id: 188130682107985920
    m_Localized: "Dunkelt den Rand der Sicht ab, w\xE4hrend der Stick dich bewegt
      oder dreht"
    m_Metadata:
      m_Items: []
  - m_Id: 188130682107985921
    m_Localized: aus|leicht|stark
    m_Metadata:
      m_Items: []
  - m_Id: 188130682107985922
    m_Localized: "Textgr\xF6\xDFe"
    m_Metadata:
      m_Items: []
  - m_Id: 188130682107985923
    m_Localized: "Gr\xF6\xDFe der Untertitel und der Dialogauswahl"
    m_Metadata:
      m_Items: []
  - m_Id: 188130682107985924
    m_Localized: "normal|gro\xDF|gr\xF6\xDFer"
    m_Metadata:
      m_Items: []
  - m_Id: 188218529716502528
    m_Localized: Farbsehen
    m_Metadata:
      m_Items: []
  - m_Id: 188218529745862656
    m_Localized: Passt die Farben bei Farbenblindheit an
    m_Metadata:
      m_Items: []
  - m_Id: 188218529745862657
    m_Localized: "normal|Rotschw\xE4che|Gr\xFCnschw\xE4che|Blauschw\xE4che"
    m_Metadata:
      m_Items: []
  - m_Id: 188454143623823360
    m_Localized: "H\xE4ndigkeit"
    m_Metadata:
      m_Items: []
  - m_Id: 188454143661572096
    m_Localized: "Linksh\xE4nder: Laufen und Men\xFC am rechten Controller, Drehen,
      Teleport und Springen am linken"
    m_Metadata:
      m_Items: []
  - m_Id: 188454143661572097
    m_Localized: "Rechtsh\xE4nder|Linksh\xE4nder"
    m_Metadata:
      m_Items: []
  - m_Id: 188454143661572098
    m_Localized: Sprungtaste
    m_Metadata:
      m_Items: []
  - m_Id: 188454143661572099
    m_Localized: Die Taste zum Springen - Ducken liegt auf der anderen der beiden
      Tasten
    m_Metadata:
      m_Items: []
  - m_Id: 188454143661572100
    m_Localized: "untere Taste|obere Taste|Stick dr\xFCcken"
    m_Metadata:
      m_Items: []
  - m_Id: 188454143661572101
    m_Localized: "Men\xFCtaste"
    m_Metadata:
      m_Items: []
  - m_Id: 188454143661572102
    m_Localized: "Die Taste, die das Men\xFC \xF6ffnet, an der Hand zum Laufen"
    m_Metadata:
      m_Items: []
  - m_Id: 188454143661572103
    m_Localized: "obere Taste|untere Taste|Men\xFCtaste"
    m_Metadata:
      m_Items: []
  - m_Id: 187174279474184192
    m_Localized: Klettern
    m_Metadata:
      m_Items: []
  - m_Id: 187174279558070272
    m_Localized: 'Gegriffene Kanten: selbst hochziehen oder hinaufblenden (weniger
      Bewegung)'
    m_Metadata:
      m_Items: []
  - m_Id: 187174279558070273
    m_Localized: hochziehen|blenden
    m_Metadata:
      m_Items: []
  - m_Id: 187174279558070274
    m_Localized: Kletterhinweise
    m_Metadata:
      m_Items: []
  - m_Id: 187174279558070275
    m_Localized: "Hand schlie\xDFt sich und vibriert an Kanten; leuchten markiert
      die Kante"
    m_Metadata:
      m_Items: []
  - m_Id: 187174279558070276
    m_Localized: aus|leuchten
    m_Metadata:
      m_Items: []
  - m_Id: 187053241054658560
    m_Localized: "H\xF6henversatz"
    m_Metadata:
      m_Items: []
  - m_Id: 187053241104990208
    m_Localized: "Kamerah\xF6he in 5-cm-Schritten. Mitte = kein Versatz"
    m_Metadata:
      m_Items: []
  - m_Id: 187128268206768128
    m_Localized: "Speichern nicht m\xF6glich: Es l\xE4uft kein Spiel."
    m_Metadata:
      m_Items: []
  - m_Id: 187128268236128256
    m_Localized: "Speichern nicht m\xF6glich, solange du tot bist."
    m_Metadata:
      m_Items: []
  - m_Id: 187128268236128257
    m_Localized: "Speichern ist w\xE4hrend eines Dialogs nicht m\xF6glich."
    m_Metadata:
      m_Items: []
  - m_Id: 188222179017875456
    m_Localized: 'Laden fehlgeschlagen: Der Spielstand kann nicht gelesen werden.'
    m_Metadata:
      m_Items: []
  - m_Id: 188222179131121664
    m_Localized: Speichern fehlgeschlagen. Der vorherige Spielstand bleibt erhalten.
    m_Metadata:
      m_Items: []
  - m_Id: 2692900000000000
    m_Localized: "\xFCberspringen"
    m_Metadata:
      m_Items: []
  - m_Id: 191288694340444160
    m_Localized: "Held st\xFCrzt"
    m_Metadata:
      m_Items: []
  - m_Id: 191288694365609984
    m_Localized: "Bewusstlos, tot oder schlafend: die Sicht sinkt mit dem K\xF6rper
      oder blendet (weniger Bewegung)"
    m_Metadata:
      m_Items: []
  - m_Id: 191288694365609985
    m_Localized: "mit K\xF6rper|blenden"
    m_Metadata:
      m_Items: []
  - m_Id: 193305458028961792
    m_Localized: Alles nehmen
    m_Metadata:
      m_Items: []
  - m_Id: 193331266604883968
    m_Localized: Gegenstandsdetails
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244096
    m_Localized: Rucksack in einer Hand, Gegenstand in der anderen zeigt seinen Text
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244097
    m_Localized: Rucksack-Sog
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244098
    m_Localized: "Der offene Rucksack zieht Gegenst\xE4nde in der N\xE4he an"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244099
    m_Localized: 'Beute: alles nehmen'
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244100
    m_Localized: Ein Beute-Rucksack zeigt "Alles nehmen" unter den Seiten
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244101
    m_Localized: Blocken
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244102
    m_Localized: "Beide H\xE4nde an einer Nahkampfwaffe, beide Trigger halten: parieren"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244103
    m_Localized: Schritte
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244104
    m_Localized: Schritte klingen nach dem Untergrund
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244105
    m_Localized: Trefferzahlen
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244106
    m_Localized: "-X LP / +X MANA \xFCber den K\xF6pfen der NPCs"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244107
    m_Localized: "Gr\xF6\xDFe der Trefferzahlen"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244108
    m_Localized: "Gr\xF6\xDFe der -X LP / +X MANA Zahlen"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244109
    m_Localized: LP-Zahlen
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244110
    m_Localized: LP/MAX auf den Lebensbalken
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244111
    m_Localized: In Dialogen laufen
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244112
    m_Localized: Beim Sprechen herumlaufen - Weggehen beendet den Dialog
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244113
    m_Localized: Licht-Aktualisierung
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244114
    m_Localized: "Wie fl\xFCssig das Licht einer Fackel deiner Hand folgt"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244115
    m_Localized: Niedrig|Mittel|Hoch
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244116
    m_Localized: "H\xE4nde des Helden"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244117
    m_Localized: "Deine H\xE4nde sind die F\xE4uste des Helden"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244118
    m_Localized: Erledigen
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244119
    m_Localized: 'Zustechen und die Klinge halten, um zu erledigen (aus: jeder Treffer)'
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244120
    m_Localized: Armbrust
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244121
    m_Localized: 'Sehne spannen zum Nachladen (aus: automatisch)'
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244122
    m_Localized: Einmal-Schriftrollen
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244123
    m_Localized: Ein Wirken verbraucht die Rolle (Gothic)
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244124
    m_Localized: Geworfene Zauber
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244125
    m_Localized: Ausholen und loslassen, um Projektilzauber zu werfen
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244126
    m_Localized: Zweihand-Aufladung
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244127
    m_Localized: "Aufgeladene Zauber wachsen nur mit beiden H\xE4nden zusammen"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244128
    m_Localized: Favoriten-Ring
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244129
    m_Localized: "Beide H\xE4nde hoch + beide Trigger: ausger\xFCstete Zauber und
      Waffen"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244130
    m_Localized: Taschendiebstahl-Beutel
    m_Metadata:
      m_Items: []
  - m_Id: 193331266638438400
    m_Localized: "G2: beim Schleichen ein Beutel zum Greifen bei jedem, den du bestehlen
      k\xF6nntest"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266638438401
    m_Localized: "Gr\xF6\xDFe des Favoriten-Rings"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266638438402
    m_Localized: Wie weit der Favoriten-Ring von dir entfernt ist (rechter Stick,
      solange er offen ist)
    m_Metadata:
      m_Items: []
