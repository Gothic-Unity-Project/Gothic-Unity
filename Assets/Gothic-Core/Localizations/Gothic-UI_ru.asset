  - m_Id: 193331266634244109
    m_Localized: "\u0427\u0438\u0441\u043B\u0430 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244110
    m_Localized: "\u0417\u0414\u0420/\u041C\u0410\u041A\u0421 \u043D\u0430 \u043F\u043E\u043B\u043E\u0441\u043A\u0430\u0445
      \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244111
    m_Localized: "\u0425\u043E\u0434\u044C\u0431\u0430 \u0432 \u0434\u0438\u0430\u043B\u043E\u0433\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244112
    m_Localized: "\u0414\u0432\u0438\u0433\u0430\u0439\u0442\u0435\u0441\u044C \u0432\u043E
      \u0432\u0440\u0435\u043C\u044F \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0430
      - \u0435\u0441\u043B\u0438 \u043E\u0442\u043E\u0439\u0442\u0438, \u0434\u0438\u0430\u043B\u043E\u0433
      \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244113
    m_Localized: "\u041E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435 \u0441\u0432\u0435\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244114
    m_Localized: "\u041D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043F\u043B\u0430\u0432\u043D\u043E
      \u0441\u0432\u0435\u0442 \u0444\u0430\u043A\u0435\u043B\u0430 \u0441\u043B\u0435\u0434\u0443\u0435\u0442
      \u0437\u0430 \u0440\u0443\u043A\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244115
    m_Localized: "\u041D\u0438\u0437\u043A\u043E\u0435|\u0421\u0440\u0435\u0434\u043D\u0435\u0435|\u0412\u044B\u0441\u043E\u043A\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244116
    m_Localized: "\u0420\u0443\u043A\u0438 \u0433\u0435\u0440\u043E\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244117
    m_Localized: "\u0412\u0430\u0448\u0438 \u0440\u0443\u043A\u0438 - \u043A\u0443\u043B\u0430\u043A\u0438
      \u0433\u0435\u0440\u043E\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244118
    m_Localized: "\u0414\u043E\u0431\u0438\u0432\u0430\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244119
    m_Localized: "\u0412\u043E\u043D\u0437\u0438\u0442\u0435 \u0438 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435
      \u043A\u043B\u0438\u043D\u043E\u043A, \u0447\u0442\u043E\u0431\u044B \u0434\u043E\u0431\u0438\u0442\u044C
      (\u0432\u044B\u043A\u043B.: \u043B\u044E\u0431\u043E\u0439 \u0443\u0434\u0430\u0440)"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244120
    m_Localized: "\u0410\u0440\u0431\u0430\u043B\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244121
    m_Localized: "\u041D\u0430\u0442\u044F\u043D\u0438\u0442\u0435 \u0442\u0435\u0442\u0438\u0432\u0443
      \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0438
      (\u0432\u044B\u043A\u043B.: \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438)"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244122
    m_Localized: "\u041E\u0434\u043D\u043E\u0440\u0430\u0437\u043E\u0432\u044B\u0435
      \u0441\u0432\u0438\u0442\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244123
    m_Localized: "\u041F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u0440\u0430\u0441\u0445\u043E\u0434\u0443\u0435\u0442
      \u0441\u0432\u0438\u0442\u043E\u043A (\u043A\u0430\u043A \u0432 Gothic)"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244124
    m_Localized: "\u041C\u0435\u0442\u0430\u0435\u043C\u044B\u0435 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244125
    m_Localized: "\u0412\u0437\u043C\u0430\u0445\u043D\u0438\u0442\u0435 \u0438 \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u0435,
      \u0447\u0442\u043E\u0431\u044B \u043C\u0435\u0442\u043D\u0443\u0442\u044C \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0435-\u0441\u043D\u0430\u0440\u044F\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244128
    m_Localized: "\u041A\u0440\u0443\u0433 \u0438\u0437\u0431\u0440\u0430\u043D\u043D\u043E\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244129
    m_Localized: "\u041E\u0431\u0435 \u0440\u0443\u043A\u0438 \u0432\u0432\u0435\u0440\u0445
      + \u043E\u0431\u0430 \u0442\u0440\u0438\u0433\u0433\u0435\u0440\u0430: \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u044F \u0438 \u043E\u0440\u0443\u0436\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244130
    m_Localized: "\u041A\u043E\u0448\u0435\u043B\u0451\u043A \u043A\u0430\u0440\u043C\u0430\u043D\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266638438400
    m_Localized: "G2: \u0432 \u0440\u0435\u0436\u0438\u043C\u0435 \u0441\u043A\u0440\u044B\u0442\u043D\u043E\u0441\u0442\u0438
      - \u043A\u043E\u0448\u0435\u043B\u0451\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043C\u043E\u0436\u043D\u043E \u0441\u0445\u0432\u0430\u0442\u0438\u0442\u044C
      \u0443 \u0442\u0435\u0445, \u043A\u043E\u0433\u043E \u043C\u043E\u0436\u043D\u043E
      \u043E\u0431\u043E\u043A\u0440\u0430\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 193331266638438401
    m_Localized: "\u0420\u0430\u0437\u043C\u0435\u0440 \u043A\u0440\u0443\u0433\u0430
