      m_Items: []
  - m_Id: 193331266634244096
    m_Localized: "\u0420\u044E\u043A\u0437\u0430\u043A \u0432 \u043E\u0434\u043D\u043E\u0439
      \u0440\u0443\u043A\u0435, \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u0432
