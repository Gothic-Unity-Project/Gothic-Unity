  - m_Id: 193347490881593344
    m_Localized: Walk
    m_Metadata:
      m_Items: []
  - m_Id: 193347490894176256
    m_Localized: 'Click: Sprint'
    m_Metadata:
      m_Items: []
  - m_Id: 193347490894176257
    m_Localized: Menu
    m_Metadata:
      m_Items: []
  - m_Id: 193347490894176258
    m_Localized: 'Turn - pull back: teleport'
    m_Metadata:
      m_Items: []
  - m_Id: 193347490894176259
    m_Localized: Jump
    m_Metadata:
      m_Items: []
  - m_Id: 193347490894176260
    m_Localized: 'Click: Jump'
    m_Metadata:
      m_Items: []
  - m_Id: 193347490894176261
    m_Localized: Sneak
    m_Metadata:
      m_Items: []
  - m_Id: 193347490894176262
    m_Localized: Use (torch, book, spell)
    m_Metadata:
      m_Items: []
  - m_Id: 193347490894176263
    m_Localized: Grab / talk to NPC
    m_Metadata:
      m_Items: []
  - m_Id: 193347490894176264
    m_Localized: 'Both empty hands above your head + both triggers: favorites ring'
    m_Metadata:
      m_Items: []
  - m_Id: 193347490894176265
    m_Localized: VR Help
    m_Metadata:
      m_Items: []
  - m_Id: 193347490894176266
    m_Localized: Swimming & diving
    m_Metadata:
      m_Items: []
  - m_Id: 193347490894176267
    m_Localized: Hold + stroke
    m_Metadata:
      m_Items: []
  - m_Id: 193347490894176268
    m_Localized: 'Chest-deep water: you swim. Hold the grips and pull your arms through
      the water. A strong stroke down dives, stroke up to surface. The view darkens
      when your air runs out. You can''t grab things while swimming.'
    m_Metadata:
      m_Items: []
  - m_Id: 193347490894176269
    m_Localized: Trade
    m_Metadata:
      m_Items: []
  - m_Id: 193347490894176270
    m_Localized: Take / lay down items
    m_Metadata:
      m_Items: []
  - m_Id: 193347490894176271
    m_Localized: Press OK / X
    m_Metadata:
      m_Items: []
  - m_Id: 193347490894176272
    m_Localized: 'Choose trade in the dialog: a counter appears. Left: lay down what
      you sell. Right: take what you buy. The middle shows the difference - OK pays
      it with ore/gold from your inventory, X closes. Arrows scroll the rings.'
    m_Metadata:
      m_Items: []
  - m_Id: 193347490894176273
    m_Localized: Magic
    m_Metadata:
      m_Items: []
  - m_Id: 193347490894176274
    m_Localized: Hold rune / scroll
    m_Metadata:
      m_Items: []
  - m_Id: 193347490894176275
    m_Localized: 'Hold: charge, release: cast'
    m_Metadata:
      m_Items: []
  - m_Id: 193347490894176276
    m_Localized: 'Charged spells grow only with both hands together. Projectile spells:
      the empty hand holds its trigger, swing and let go to throw. Choose spells
      in the favorites ring: both empty hands above your head, hold both triggers.'
    m_Metadata:
      m_Items: []
  - m_Id: 193347490894176277
    m_Localized: Bows & crossbows
    m_Metadata:
      m_Items: []
  - m_Id: 193347490894176278
    m_Localized: 'Bow: grab string, pull, let go'
    m_Metadata:
      m_Items: []
  - m_Id: 193347490894176279
    m_Localized: 'Crossbow: fire'
    m_Metadata:
      m_Items: []
  - m_Id: 193347490894176280
    m_Localized: 'Bow: an arrow from your inventory is nocked by itself. The further
      you pull, the stronger the shot. Crossbow: reload with the free hand - trigger
      on the string at the front, pull it back until it locks.'
    m_Metadata:
      m_Items: []
