    m_Metadata:
      m_Items: []
  - m_Id: 186269666525962240
    m_Localized: Mani fisiche
    m_Metadata:
      m_Items: []
  - m_Id: 186269666597265408
    m_Localized: Le mani si fermano contro muri e oggetti e spingono gli oggetti
      sciolti
    m_Metadata:
      m_Items: []
