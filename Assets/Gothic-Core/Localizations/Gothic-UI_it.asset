  m_TableData:
  - m_Id: 431630484627456
    m_Localized: _
    m_Metadata:
      m_Items: []
  - m_Id: 193305458028961792
    m_Localized: Prendi tutto
    m_Metadata:
      m_Items: []
  - m_Id: 193331266604883968
    m_Localized: Dettagli oggetto
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244096
    m_Localized: 'Zaino in una mano, oggetto nell''altra: mostra il suo testo'
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244097
    m_Localized: Aspirazione zaino
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244098
    m_Localized: Lo zaino aperto attira gli oggetti vicini
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244099
    m_Localized: 'Bottino: prendi tutto'
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244100
    m_Localized: Uno zaino del bottino mostra "Prendi tutto" sotto le pagine
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244101
    m_Localized: Parata
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244102
    m_Localized: 'Entrambe le mani su un''arma da mischia, entrambi i grilletti premuti:
      pari'
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244103
    m_Localized: Passi
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244104
    m_Localized: I passi suonano in base al terreno
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244105
    m_Localized: Numeri di danno
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244106
    m_Localized: -X PV / +X MANA sopra la testa degli NPC
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244107
    m_Localized: Dimensione numeri
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244108
    m_Localized: Dimensione dei numeri -X PV / +X MANA
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244109
    m_Localized: Numeri PV
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244110
    m_Localized: PV/MAX sulle barre della salute
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244111
    m_Localized: Muoversi nei dialoghi
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244112
    m_Localized: Muoviti mentre parli - allontanarsi chiude il dialogo
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244113
    m_Localized: Aggiornamento luce
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244114
    m_Localized: Quanto fluidamente la luce di una torcia segue la mano
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244115
    m_Localized: Basso|Medio|Alto
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244116
    m_Localized: Mani dell'eroe
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244117
    m_Localized: Le tue mani sono i pugni dell'eroe
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244118
    m_Localized: Colpo di grazia
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244119
    m_Localized: 'Colpisci e tieni la lama dentro per finire (disattivato: qualsiasi
      colpo)'
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244120
    m_Localized: Balestra
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244121
    m_Localized: 'Tira la corda per ricaricare (disattivato: automatico)'
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244122
    m_Localized: Pergamene monouso
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244123
    m_Localized: Un lancio consuma la pergamena (Gothic)
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244124
    m_Localized: Incantesimi lanciati
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244125
    m_Localized: Fai oscillare e lascia per lanciare gli incantesimi proiettile
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244126
    m_Localized: Carica a due mani
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244127
    m_Localized: Gli incantesimi caricati crescono solo con entrambe le mani unite
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244128
    m_Localized: Anello dei preferiti
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244129
    m_Localized: 'Entrambe le mani in alto + entrambi i grilletti: incantesimi e
      armi equipaggiati'
    m_Metadata:
      m_Items: []
  - m_Id: 193331266634244130
    m_Localized: Borsello da borseggio
    m_Metadata:
      m_Items: []
  - m_Id: 193331266638438400
    m_Localized: 'G2: di soppiatto, una borsa da afferrare su chi puoi borseggiare'
    m_Metadata:
      m_Items: []
  - m_Id: 193331266638438401
    m_Localized: Dimensione anello preferiti
    m_Metadata:
      m_Items: []
  - m_Id: 193331266638438402
    m_Localized: "A che distanza si trova l'anello dei preferiti (stick destro mentre
      \xE8 aperto)"
    m_Metadata:
      m_Items: []
