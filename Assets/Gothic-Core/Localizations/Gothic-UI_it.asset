    m_Metadata:
      m_Items: []
  - m_Id: 2692483179208704
    m_Localized: Usato per il riconoscimento vocale durante i dialoghi, se selezionato
    m_Metadata:
      m_Items: []
  - m_Id: 2692692542087168
